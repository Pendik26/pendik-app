{
  "name": "medicine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A study app for flashcards, quizzes, ebooks and summaries: works offline as a guest, with optional accounts that sync progress across devices.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neccrr/medicine"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "lint:css": "stylelint \"**/*.css\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "MEDICINE_API=memory vite",
    "graph:relations": "node scripts/graph-relations.mjs",
    "docs:wiki": "node scripts/wiki.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "d3-force": "^3.0.0",
    "fuse.js": "^7.5.0",
    "marked": "^18.0.13",
    "mongodb": "^7.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.1",
    "oxlint": "^1.81.0",
    "stylelint": "^16.25.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
