# Copy to .env.local for `npm run dev`, or set these in Vercel → Project → Settings → Environment
# Variables. They're read at build time and end up in the browser, so only public values go here.
# The server's secrets are Supabase Edge Function secrets instead: see docs/deploying.md.

# The Supabase project: Project Settings → API. The publishable (anon) key is safe in the browser;
# row level security decides what it can read.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Shows "Explain this" and Alfond. Set to true once the ai function's AI_* secrets are set.
VITE_AI_ENABLED=false

# Optional: the site's public origin for link-preview tags and the sitemap, at build time.
# Defaults to https://pendik-app.vercel.app.
SITE_URL=

# Optional: Search Console's HTML-tag verification token, at build time.
GOOGLE_SITE_VERIFICATION=
