# Copy to .env.local for `vercel dev`, or set these in Vercel → Project → Settings → Environment Variables.
# Without MONGODB_URI and BETTER_AUTH_SECRET the app runs as a guest-only static site.

# MongoDB Atlas connection string for a user with readWrite on the database below.
MONGODB_URI=mongodb+srv://medicine-app:<password>@cluster0.jbgup5e.mongodb.net/?retryWrites=true&w=majority&appName=medicine
MONGODB_DB=medicine

# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the production site (defaults to Vercel's production domain).
BETTER_AUTH_URL=https://medicine.necr.help

# Optional: origin used in link-preview tags (og:url, og:image, twitter:image) at build time.
# Defaults to https://medicine.necr.help.
SITE_URL=

# Optional: comma-separated extra origins allowed to call the auth API (e.g. a custom domain).
TRUSTED_ORIGINS=

# Optional: enables "Continue with Google". Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the Class Drive page, listing a Google Drive folder shared by link (signed-in students only).
# GOOGLE_DRIVE_API_KEY=          # a Google Cloud API key restricted to the Drive API
# GOOGLE_DRIVE_FOLDER_ID=        # the folder's id, or its share link
# GOOGLE_DRIVE_REFRESH_MINUTES=5
# GOOGLE_DRIVE_ON_DEMAND_FOLDERS=  # optional: folders outside the class folder to show as linked folders
#                                 (folder shortcuts inside it are linked folders already)

# Optional: "Ask AI to explain" through an OpenAI-compatible gateway (NaraRouter).
# AI_BASE_URL=        # the gateway's OpenAI-compatible URL, ending in /v1
# AI_API_KEY=
# AI_MODEL=           # one model id, or several comma-separated as fallbacks
# AI_DAILY_LIMIT=30
