# Copy to .env.local for `npm run dev`, or set these in Vercel → Project → Settings → Environment
# Variables. The VITE_ and SITE_ ones are read at build time and end up in the browser; the
# rest are the server's secrets and are read only by api/index.ts (see docs/deploying.md).

# --- The server (never put these in the browser) ---
# MongoDB Atlas connection string, and the database name (default: pendik).
MONGODB_URI=
MONGODB_DB=pendik
# A long random string (openssl rand -base64 32) that signs sessions.
BETTER_AUTH_SECRET=
# The first admin, created on the first request while the site has no admin. Remove afterwards.
FIRST_ADMIN_NIM=
FIRST_ADMIN_NAME=
# Optional: "Continue with Google" (Google Cloud → OAuth client; redirect URI <site>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: other origins allowed to call the API, comma separated.
APP_ORIGINS=
# Optional: the class Drive sync (see docs/deploying.md).
DRIVE_SYNC_SECRET=

# --- The browser ---
# Shows "Explain this" and Alfond. Set to true once the server's AI_* settings are set.
VITE_AI_ENABLED=false

# Optional: the site's public origin for link-preview tags and the sitemap, at build time.
# Defaults to https://pendik-app.vercel.app.
SITE_URL=

# Optional: Search Console's HTML-tag verification token, at build time.
GOOGLE_SITE_VERIFICATION=
